# Convex project values (from `npx convex dev` or dashboard)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth app credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Test-only credentials auth for local E2E (never enable in production)
E2E_AUTH_ENABLED=0
NEXT_PUBLIC_E2E_AUTH_ENABLED=0
E2E_TEST_SECRET=

# Email magic-link auth
MAGIC_LINK_EMAIL_MODE=log
MAGIC_LINK_FROM=
MAGIC_LINK_SMTP_URL=


# Private key used by NextAuth session callback to sign Convex JWTs
CONVEX_AUTH_PRIVATE_KEY=
# Key id included in JWT header, must match `kid` in JWKS
CONVEX_AUTH_KID=

# Paddle Billing
PADDLE_ENV=sandbox
# Public Paddle.js config. Keep NEXT_PUBLIC_PADDLE_ENV in sync with PADDLE_ENV.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_FORWARD_SECRET=
# Backward-compatible Pro price IDs
PADDLE_PRICE_ID_MONTHLY=
# Preferred explicit checkout price IDs
PADDLE_PRICE_ID_PRO_MONTHLY=
# Required if you want returning users to re-subscribe without a trial, or if FREE_PRO_PLUS_TRIAL_DAYS=0.
PADDLE_PRICE_ID_PRO_MONTHLY_NO_TRIAL=
# Monthly Pro preview quota for premium voice, counted in characters
PRO_PREMIUM_TTS_PREVIEW_CHARS=60000
# Paddle trial window (days) for the Pro checkout flow, with full premium voice access during trial
FREE_PRO_PLUS_TRIAL_DAYS=3

# Premium voice
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE_EN=en-US-AvaMultilingualNeural
AZURE_SPEECH_VOICE_ZH=zh-CN-XiaoxiaoNeural

# AI card generation (Groq, OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=moonshotai/kimi-k2-instruct-0905
