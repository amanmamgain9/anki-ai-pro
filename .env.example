# Convex project values (from `npx convex dev` or dashboard)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth app credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# Private key used by NextAuth session callback to sign Convex JWTs
CONVEX_AUTH_PRIVATE_KEY=
# Key id included in JWT header, must match `kid` in JWKS
CONVEX_AUTH_KID=

# Paddle Billing
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_FORWARD_SECRET=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=

# AI card generation (Kimi, OpenAI-compatible endpoint)
KIMI_API_KEY=
KIMI_BASE_URL=https://api.groq.com/openai/v1
KIMI_MODEL=moonshotai/kimi-k2-instruct-0905
